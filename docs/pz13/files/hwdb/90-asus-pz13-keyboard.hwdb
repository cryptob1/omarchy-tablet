# ASUS ProArt PZ13 (HT5306QA, Snapdragon X) detachable keyboard, USB 0B05:1B6E.
#
# hid-asus has no entry for 1B6E, so hid-generic drives it and the Fn key does
# nothing at all: Fn+F3 and plain F3 both arrive as KEY_F3 (verified with a raw
# evdev capture on z13-omarchy, 2026-11-09). The printed media functions are
# therefore unreachable, so map the top row to them here. F8 and F10-F12 stay
# F-keys (F8 is the Cortex hold-to-talk key on this machine).
#
# Scancodes are HID keyboard-page usages (0x7003a = F1 ... 0x70043 = F10).
evdev:input:b0003v0B05p1B6E*
 KEYBOARD_KEY_7003a=mute
 KEYBOARD_KEY_7003b=volumedown
 KEYBOARD_KEY_7003c=volumeup
 KEYBOARD_KEY_7003d=kbdillumtoggle
 KEYBOARD_KEY_7003e=brightnessdown
 KEYBOARD_KEY_7003f=brightnessup
 KEYBOARD_KEY_70040=touchpad_toggle
 KEYBOARD_KEY_70042=micmute
#
# Keep BOTH layers' keycodes advertised at all times. libinput (and so
# Hyprland) reads a device's key list once, when it opens it, and silently drops
# any keycode that was not on that list. The kernel only advertises a keycode
# while some scancode maps to it, so without these the Fn-lock toggle
# (bin/pz13-fnlock) sends F1-F7/F9 that libinput never passes on -- and a remap
# applied to an already-open keyboard drops the media keys the same way
# (z13-omarchy 2026-11-09: brightness dead until the keyboard was replugged).
# These scancodes are F13-F22/F24 and LANG keys, which this keyboard never sends.
 KEYBOARD_KEY_70068=f1
 KEYBOARD_KEY_70069=f2
 KEYBOARD_KEY_7006a=f3
 KEYBOARD_KEY_7006b=f4
 KEYBOARD_KEY_7006c=f5
 KEYBOARD_KEY_7006d=f6
 KEYBOARD_KEY_7006e=f7
 KEYBOARD_KEY_7006f=f9
 KEYBOARD_KEY_70070=brightnessdown
 KEYBOARD_KEY_70071=brightnessup
 KEYBOARD_KEY_70073=kbdillumtoggle
 KEYBOARD_KEY_7008a=micmute
 KEYBOARD_KEY_7008b=touchpad_toggle
