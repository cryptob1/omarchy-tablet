+/*
+ * ASUS ProArt PZ13: the two WSA8845 amplifiers on the v2.0.0 WSA bus come
+ * back from a clock stop silent (attached but dead, or after a bus clash)
+ * every day or so, until a reboot. Take the same path as v3.1.0: no clock
+ * stop on runtime suspend, soft reset and re-enumeration on runtime resume.
+ *   reenumerate=-1  per board (default)   0  never   1  always
+ */
+static int reenumerate = -1;
+module_param(reenumerate, int, 0644);
+MODULE_PARM_DESC(reenumerate, "Reset and re-enumerate the bus on runtime resume instead of clock stop (-1: per board, 0: off, 1: on)");
+
+static bool swrm_reenumerate_on_resume(void)
+{
+	if (reenumerate >= 0)
+		return reenumerate;
+	return of_machine_is_compatible("asus,proart-pz13-ht5306qa");
+}
