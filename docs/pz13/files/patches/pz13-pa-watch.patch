+static bool wsa884x_pa_watch(struct wsa884x_priv *wsa884x);
+
+static bool wsa884x_pa_watch(struct wsa884x_priv *wsa884x)
+{
+	return pa_watch >= 0 ? pa_watch : wsa884x->pa_watch;
+}
