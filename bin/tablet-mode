#!/usr/bin/env python3
"""tablet-mode — one switch for "this machine is a tablet right now".

Whatever DETECTS tablet use calls `tablet-mode set tablet|laptop`; everything
that REACTS reads the state file or runs as a hook. Detectors:
  * detachable keyboards (ASUS ProArt PZ13): `tablet-mode watch` — tablet while
    none of the USB keyboards listed in ~/.config/tablet-mode/keyboards
    (vid:pid per line) is attached.
  * anything else (a fold sensor, a hotkey, a script): call `set` yourself.

Reactions:
  * ~/.local/state/tablet-mode/state  — "tablet" | "laptop"; the tablet.rail
    shell plugin watches it to show the button rail.
  * leaving tablet mode hides the on-screen keyboard.
  * every executable in ~/.config/tablet-mode/hooks.d/ runs with the new mode.

    tablet-mode set tablet|laptop | toggle | status
    tablet-mode mic always|auto      keep the mic button on screen in laptop mode too
    tablet-mode rails both|right     a rail on each edge (default), or one on the right
    tablet-mode look <name>          how the rails are drawn: theme (plain Omarchy),
                                     controller, cheetah, tiger, arcade, neon, retro,
                                     candy, lava, galaxy, ice, rainbow, unicorn, fairy,
                                     mermaid, dragon, sunset, watermelon, honeybee,
                                     circuit, pixel, prism
    tablet-mode rotate landscape|portrait|auto
                                     how the screen is turned. landscape and portrait
                                     stay put; auto follows the tablet's orientation
                                     sensor, where it has one (needs iio-sensor-proxy)
    tablet-mode rotate toggle|flip   swap landscape and portrait; turn upside down
    tablet-mode sounds on|off        a soft tap as a rail button goes down
    tablet-mode dictation on|off     show the mic button at all (needs a dictation
                                     backend: see `tablet-touch` DICTATION)
    tablet-mode watch                detachable-keyboard detector (user service)
"""
import glob
import json
import os
import subprocess
import sys

# The rails' looks; must match lookNames in shell/plugins/tablet.rail/Main.qml.
LOOKS = ("theme", "controller", "cheetah", "tiger", "arcade", "neon", "retro", "candy", "lava", "galaxy", "ice",
         "rainbow", "unicorn", "fairy", "mermaid", "dragon", "sunset", "watermelon", "honeybee", "circuit", "pixel", "prism")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "tablet-mode")
CONF_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
CONF_DIR = os.path.join(CONF_HOME, "tablet-mode")
BIN = os.path.expanduser("~/.local/bin/")


def read(path, default):
    try:
        return open(path).read().strip() or default
    except OSError:
        return default


def write(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(value + "\n")
    os.replace(tmp, path)   # atomic, so the shell's file watcher never reads half


def status():
    return read(os.path.join(STATE_DIR, "state"), "laptop")


def set_mode(mode, force=False):
    if mode not in ("tablet", "laptop"):
        sys.exit("tablet-mode: set tablet|laptop")
    if mode == status() and not force:
        return
    write(os.path.join(STATE_DIR, "state"), mode)
    if mode == "laptop":
        subprocess.run([BIN + "tablet-osk", "hide"], stderr=subprocess.DEVNULL)
        # With the keyboard on, the screen stands in landscape, and the rails
        # (and the rotate button on them) are gone: do not leave it sideways.
        _, transform = panel()
        if transform % 2:
            rotate("landscape")
    for hook in sorted(glob.glob(os.path.join(CONF_DIR, "hooks.d", "*"))):
        if os.access(hook, os.X_OK):
            subprocess.run([hook, mode], timeout=20)
    print(mode)


def keyboards():
    ids = set()
    for line in read(os.path.join(CONF_DIR, "keyboards"), "").splitlines():
        line = line.split("#")[0].strip().lower()
        if ":" in line:
            ids.add(line)
    return ids


def attached(ids):
    for dev in glob.glob("/sys/bus/usb/devices/*/idVendor"):
        d = os.path.dirname(dev)
        if f"{read(dev, '')}:{read(d + '/idProduct', '')}".lower() in ids:
            return True
    return False


def watch():
    ids = keyboards()
    if not ids:
        sys.exit("tablet-mode watch: no keyboards listed in " + os.path.join(CONF_DIR, "keyboards"))

    def check():
        set_mode("laptop" if attached(ids) else "tablet")

    check()
    mon = subprocess.Popen(["udevadm", "monitor", "--udev", "--subsystem-match=usb"],
                           stdout=subprocess.PIPE, text=True)
    for line in mon.stdout:
        if " add " in line or " remove " in line or " bind " in line or " unbind " in line:
            check()
    sys.exit(mon.wait() or 1)   # let systemd restart a dead monitor


# ── rotation ────────────────────────────────────────────────────────────────
# Degrees clockwise, as omarchy-hyprland-monitor-rotate takes them.
SENSOR_TURN = {"normal": 0, "left-up": 90, "bottom-up": 180, "right-up": 270}


def panel():
    """The built-in screen's name: the eDP/DSI/LVDS output, else the first."""
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return "", 0
    for m in mons:
        if str(m.get("name", "")).startswith(("eDP", "DSI", "LVDS")):
            return m["name"], int(m.get("transform") or 0)
    return (mons[0]["name"], int(mons[0].get("transform") or 0)) if mons else ("", 0)


ROTATION_LUA = os.path.join(CONF_HOME, "hypr", "omarchy-tablet-rotation.lua")


def align_input(transform=None):
    """Turn touch and pen input the same way as the screen.

    Hyprland does NOT do this by itself: rotate the monitor and a finger still
    lands where it would have on the unrotated screen (found the hard way, on
    the first portrait test). The setting is also written to a file that
    hypr/omarchy-tablet.lua loads, because the screen's rotation is remembered
    across `hyprctl reload` and restarts while a bare `hyprctl eval` is not —
    without the file, the first reload would misalign touch again."""
    name, seen = panel()
    if not name:
        return
    # Right after a turn Hyprland can still report the OLD transform (the turn
    # is applied a moment after the command returns), so a turn passes the
    # transform it asked for; only a bare "align" trusts what is reported.
    if transform is None:
        transform = seen
    lua = "hl.config({ input = { touchdevice = { transform = %d }, tablet = { transform = %d } } })" % (transform, transform)
    try:
        os.makedirs(os.path.dirname(ROTATION_LUA), exist_ok=True)
        tmp = ROTATION_LUA + ".tmp"
        with open(tmp, "w") as f:
            f.write("-- Written by `tablet-mode rotate`: input follows the screen's rotation.\n" + lua + "\n")
        os.replace(tmp, ROTATION_LUA)
        subprocess.run(["hyprctl", "eval", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def turn_to(degrees):
    name, _ = panel()
    if name:
        subprocess.run(["omarchy-hyprland-monitor-rotate", "--monitor", name, str(degrees % 360)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
        align_input((degrees % 360) // 90)


def has_orientation_sensor():
    """Does iio-sensor-proxy report an accelerometer? (Many ARM tablets do not
    expose theirs to Linux; then there is nothing for "auto" to follow.)"""
    try:
        out = subprocess.run(["monitor-sensor", "--accel"], capture_output=True, text=True, timeout=2).stdout
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
    except OSError:
        return False
    return "Has accelerometer" in out


def auto_service(on):
    subprocess.run(["systemctl", "--user", "enable" if on else "disable", "--now", "tablet-rotate.service"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def rotate(what):
    _, transform = panel()
    now = (transform % 4) * 90
    upright = now in (90, 270)
    keep = os.path.join(STATE_DIR, "rotation")
    if what == "status":
        print(read(keep, "landscape"))
    elif what == "align":                      # put input right for the screen as it is now
        align_input()
    elif what == "can-auto":
        print("yes" if has_orientation_sensor() else "no")
    elif what == "toggle":
        rotate("landscape" if upright else "portrait")
    elif what == "flip":                       # the same way up, the other way round
        turn_to(now + 180)
    elif what in ("landscape", "portrait"):
        auto_service(False)
        if what == "landscape" and upright:
            turn_to(0)
        elif what == "portrait" and not upright:
            turn_to(int(read(os.path.join(CONF_DIR, "portrait-turn"), "90")))   # 90 or 270: which edge is "down"
        else:
            align_input(transform % 4)     # no turn needed: still repair input left the wrong way round
        write(keep, what)
    elif what == "auto":
        if not has_orientation_sensor():
            sys.exit("tablet-mode: no orientation sensor found (is iio-sensor-proxy installed?)")
        write(keep, "auto")
        auto_service(True)
    elif what == "watch":                      # the auto-rotate service
        mon = subprocess.Popen(["monitor-sensor", "--accel"], stdout=subprocess.PIPE, text=True)
        for line in mon.stdout:
            for word, degrees in SENSOR_TURN.items():
                if line.rstrip().endswith(": " + word) or line.rstrip().endswith("(" + word + ")"):
                    turn_to(degrees)
        sys.exit(mon.wait() or 1)
    else:
        sys.exit(__doc__)


BAR_OPEN, BAR_CLOSE = "# >>> omarchy-tablet (managed: tablet-mode bar-colors)", "# <<< omarchy-tablet"


def bar_mode(skinned):
    """A bar set to "none" or "glassy" picks its own text colour from the
    wallpaper behind it, and ignores ours; but a skin's strip is what is behind
    it now. So while skinned the bar is "opaque" (made see-through by the
    alpha in bar_colors, with our text colour), and the mode it had is put back
    afterwards."""
    keep = os.path.join(STATE_DIR, "bar-background-before")
    try:
        if skinned:
            if not os.path.exists(keep):
                now = subprocess.run(["omarchy", "bar", "background"], capture_output=True, text=True, timeout=5).stdout.strip()
                if now in ("opaque", "glassy", "none"):
                    write(keep, now)
                    if now != "opaque":
                        subprocess.run(["omarchy", "bar", "background", "opaque"], capture_output=True, timeout=5)
        elif os.path.exists(keep):
            before = read(keep, "")
            os.remove(keep)
            if before in ("glassy", "none"):
                subprocess.run(["omarchy", "bar", "background", before], capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def bar_colors(text):
    """Make Omarchy's bar see-through with `text`-coloured writing (a skin's
    strip is drawn behind it), or put it back ("clear"). Edits only its own
    marked block in the [bar] section of the machine's shell overrides.

    The marks are lines of their own: a comment after a value is not safe
    here, since the colours themselves start with "#"."""
    bar_mode(text != "clear")
    path = os.path.join(CONF_HOME, "omarchy", "shell.toml")
    try:
        lines = open(path).read().splitlines()
    except OSError:
        lines = []
    kept, skipping = [], False
    for line in lines:
        if line.strip() == BAR_OPEN:
            skipping = True
        elif line.strip() == BAR_CLOSE:
            skipping = False
        elif not skipping and not line.rstrip().endswith("# omarchy-tablet"):   # (an earlier format)
            kept.append(line)
    if text != "clear":
        ours = [BAR_OPEN, "background-alpha = 0.0", f'text = "{text}"', BAR_CLOSE]
        heads = [i for i, l in enumerate(kept) if l.strip() == "[bar]"]
        if heads:
            kept[heads[0] + 1:heads[0] + 1] = ours
        else:
            kept += ([""] if kept and kept[-1].strip() else []) + ["[bar]"] + ours
    if kept == lines or (not kept and not os.path.exists(path)):
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(kept) + "\n")
    os.replace(tmp, path)


def main():
    cmd = sys.argv[1:] or ["status"]
    if cmd[0] == "set" and len(cmd) == 2:
        set_mode(cmd[1])
    elif cmd[0] == "toggle":
        set_mode("laptop" if status() == "tablet" else "tablet")
    elif cmd[0] == "status":
        print(status())
    elif cmd[0] == "mic" and len(cmd) == 2 and cmd[1] in ("always", "auto"):
        write(os.path.join(STATE_DIR, "mic"), cmd[1])
    elif cmd[0] == "rails" and len(cmd) == 2 and cmd[1] in ("both", "right"):
        write(os.path.join(STATE_DIR, "rails"), cmd[1])
    elif cmd[0] == "look" and len(cmd) == 2 and cmd[1] in LOOKS:
        write(os.path.join(STATE_DIR, "look"), cmd[1])
    elif cmd[0] == "sounds" and len(cmd) == 2 and cmd[1] in ("on", "off"):
        write(os.path.join(STATE_DIR, "sounds"), cmd[1])
    elif cmd[0] == "bar-colors" and len(cmd) == 2:
        bar_colors(cmd[1])                 # run by the rail plugin, not by hand
    elif cmd[0] == "rotate" and len(cmd) == 2:
        rotate(cmd[1])
    elif cmd[0] == "dictation" and len(cmd) == 2 and cmd[1] in ("on", "off"):
        write(os.path.join(STATE_DIR, "dictation"), cmd[1])
    elif cmd[0] == "watch":
        watch()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
