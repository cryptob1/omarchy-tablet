[Unit]
Description=omarchy-tablet: tablet mode while the detachable keyboard is off
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/tablet-mode/keyboards

[Service]
ExecStart=%h/.local/bin/tablet-mode watch
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
